{
  "root": true,
  "env": {
    "browser": true,
    "es2020": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:react-hooks/recommended"
  ],
  "ignorePatterns": ["dist"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["prettier"],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/no-unescaped-entities": 0,
    "react/prop-types": 0,
    "no-unused-vars": "off",
    "prettier/prettier": [
      "warn",
      {
        "singleQuote": false,
        "semi": true,
        "printWidth": 120,
        "trailingComma": "none"
      }
    ]
  }
}
